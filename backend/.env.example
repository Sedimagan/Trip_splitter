DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trip_splitter"
JWT_SECRET="change-me-in-production"
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed origins for CORS, e.g. https://app.example.com
# Use "*" only in local development -- never in production.
CORS_ORIGIN=*

# Leave unset to store uploaded receipts on local disk (dev only -- most hosts
# have an ephemeral filesystem). Set all four to use S3-compatible object
# storage (AWS S3, Cloudflare R2, Backblaze B2, ...) in production.
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_PUBLIC_URL_BASE=
