# URL of the Trip Splitter backend API.
# - Android emulator: http://10.0.2.2:4000
# - iOS simulator: http://localhost:4000
# - Physical device (Expo Go): http://<your-computer-LAN-IP>:4000
# - Production/EAS builds: your deployed HTTPS backend URL (also set this
#   per build profile in eas.json -- see PRODUCTION.md)
EXPO_PUBLIC_API_URL=http://localhost:4000
